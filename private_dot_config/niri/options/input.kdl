input {
    keyboard {
        xkb {
          options "caps:super"
        }
        numlock
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
    
    touchpad {
      accel-speed 0.25
      scroll-factor vertical=-0.25 horizontal=0.5
      tap-button-map "left-middle-right"
      tap
    }
}

